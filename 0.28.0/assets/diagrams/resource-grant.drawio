<mxfile>
  <diagram name="resource-grant" id="resource-grant">
    <mxGraphModel grid="0" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="How a DynamicResource grants a unit" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="750" height="30" as="geometry"/></mxCell>
        <mxCell id="task" value="task" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="grp" value="DynamicResource" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;verticalAlign=top;align=center;spacingTop=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="750" height="250" as="geometry"/></mxCell>
        <mxCell id="queue" value="queue&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;waiting requests, by queue&lt;br&gt;order and a sequence number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="users" value="users&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;granted requests,&lt;br&gt;at most capacity of them&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="rel" value="release event&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;processed one event later&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="310" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="reg" value="registry&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;current_cap, max_cap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="500" y="460" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;align=left;" edge="1" parent="1" source="task" target="queue"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="12" y="-26"/></mxGeometry></mxCell>
        <mxCell id="e2" value="granted: a unit is free&lt;br&gt;and it is at the head" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#d6b656;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="queue" target="users"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-22"/></mxGeometry></mxCell>
        <mxCell id="e3" value="release" style="align=left;edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#d6b656;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="users" target="rel"><mxGeometry x="-0.5" relative="1" as="geometry"><mxPoint as="offset" x="10"/></mxGeometry></mxCell>
        <mxCell id="e4" value="grants the head" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="rel" target="queue"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="12"/></mxGeometry></mxCell>
        <mxCell id="e5" value="capacity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#82b366;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.75;entryY=1;align=left;" edge="1" parent="1" source="reg" target="users"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="672" y="430"/></Array><mxPoint as="offset" x="12"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
