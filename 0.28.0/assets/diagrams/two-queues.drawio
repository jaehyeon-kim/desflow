<mxfile>
  <diagram name="two-queues" id="two-queues">
    <mxGraphModel grid="0" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Two kinds of queue" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="740" height="30" as="geometry"/></mxCell>
        <mxCell id="p1" value="waiting lines in the model" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=none;strokeWidth=2;dashed=1;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="45" width="365" height="430" as="geometry"/></mxCell>
        <mxCell id="l1" value="orders-3, orders-4&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;resource.queue: fifo, lifo or priority&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="305" height="60" as="geometry"/></mxCell>
        <mxCell id="l2" value="packers&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;resource.users, up to current_cap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="215" width="305" height="60" as="geometry"/></mxCell>
        <mxCell id="l3" value="QueueFull&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;a request past queue_limit&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="305" height="55" as="geometry"/></mxCell>
        <mxCell id="l4" value="Part of the model: its length and waits are in the records and statistics." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="305" height="60" as="geometry"/></mxCell>
        <mxCell id="le1" value="granted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#d6b656;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2" value="hand-off queues between threads" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=none;strokeWidth=2;dashed=1;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="395" y="45" width="345" height="430" as="geometry"/></mxCell>
        <mxCell id="r1" value="ingress queue&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;no limit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="425" y="95" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="r2" value="registry&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;every 0.1 simulation seconds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=3;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="425" y="215" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="r3" value="buffer per sink&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;on the SimPy thread&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="590" y="95" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="r4" value="queue per sink&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;at most max_queued_batches&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="590" y="215" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="r5" value="egress thread&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;writes to the sink&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="590" y="325" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="r6" value="Not part of the model: when a sink's queue is full, the simulation waits, and when it stays full for drain_stall_seconds, the run stops." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="1"><mxGeometry x="425" y="400" width="305" height="60" as="geometry"/></mxCell>
        <mxCell id="re1" value="applied" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#d6b656;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re2" value="a batch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#d6b656;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
