<mxfile>
  <diagram name="breakdown-interrupt" id="breakdown-interrupt">
    <mxGraphModel grid="0" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="A printer jam interrupts an order's labelling" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="750" height="30" as="geometry"/></mxCell>
        <mxCell id="c1" value="queued&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;waits for the printer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="c2" value="started&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;labelling, 5 s in total&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="285" y="60" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="c3" value="finished&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;releases the printer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c5" value="work done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-14"/></mxGeometry></mxCell>
        <mxCell id="c6" value="interrupted&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;publishes the cause&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="132" y="230" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="c7" value="printer_repaired&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;after 10 s on the printer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="418" y="230" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="c8" value="breakdown" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="12"/></mxGeometry></mxCell>
        <mxCell id="c9" value="repair" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-14"/></mxGeometry></mxCell>
        <mxCell id="c10" value="labels the rest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=0.0909;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="c7" target="c2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="12"/></mxGeometry></mxCell>
        <mxCell id="c11" value="chaos_monkey&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;every 12 s, interrupts the order on the printer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="57" y="390" width="350" height="60" as="geometry"/></mxCell>
        <mxCell id="c12" value="interrupt(cause)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="12"/></mxGeometry></mxCell>
        <mxCell id="c13" value="the order keeps the printer from jam to repair, so no other order starts" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=13;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="480" width="750" height="24" as="geometry"/></mxCell>
