        <mxCell id="c1" value="pack_order: a task with a service and a resource" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="600" height="28" as="geometry"/></mxCell>
        <mxCell id="c2" value="queued" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="c3" value="started" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="40" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="finished" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="610" y="40" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="c5" style="sketch=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="100" as="sourcePoint"/><mxPoint x="750" y="100" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c6" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;simulation time&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="104" width="110" height="20" as="geometry"/></mxCell>
        <mxCell id="c7" value="waits for a free packer" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="290" height="44" as="geometry"/></mxCell>
        <mxCell id="c8" value="holds the packer for the packing time" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="345" y="125" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;publishes&lt;br&gt;{status: queued}&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="180" width="130" height="40" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;publishes {status: started};&lt;br&gt;your function returns the payload&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="180" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;publishes the payload;&lt;br&gt;releases the packer&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="585" y="180" width="165" height="40" as="geometry"/></mxCell>
        <mxCell id="c12" value="return_logged: a task with no service and no resource" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="250" width="600" height="28" as="geometry"/></mxCell>
        <mxCell id="c13" value="one event: the payload" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;published the moment the task is spawned:&lt;br&gt;no queue, no waiting, nothing held&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="220" y="290" width="330" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
