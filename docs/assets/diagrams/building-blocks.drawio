        <mxCell id="c1" value="arrival&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;how often an entity enters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="250" height="60" as="geometry"/></mxCell>
