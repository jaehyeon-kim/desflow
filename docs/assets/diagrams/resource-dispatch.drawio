        <mxCell id="c5" value="token pool&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;Container, one token&lt;br&gt;per free unit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="380" width="230" height="70" as="geometry"/></mxCell>
