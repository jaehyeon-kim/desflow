        <mxCell id="c7" value="printer_repaired&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;after 10 s on the printer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="220" height="60" as="geometry"/></mxCell>
