<mxfile>
  <diagram name="event-clock" id="event-clock">
    <mxGraphModel grid="0" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c12" value="event list just after 0.0 s: what happens next, in time order" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=none;strokeColor=#d6b656;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="185" width="750" height="110" as="geometry"/></mxCell>
        <mxCell id="c1" value="simulation clock" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="160" height="28" as="geometry"/></mxCell>
        <mxCell id="c2" value="0.0 s" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="35" width="80" height="32" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;order 1 arrives,&lt;br&gt;a packer starts on it&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="-25" y="92" width="130" height="40" as="geometry"/></mxCell>
        <mxCell id="c4" value="1.5 s" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="35" width="80" height="32" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;order 1&lt;br&gt;finishes&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="175" y="92" width="130" height="40" as="geometry"/></mxCell>
        <mxCell id="c6" value="2.6 s" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="35" width="80" height="32" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;order 2 arrives,&lt;br&gt;starts&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="375" y="92" width="130" height="40" as="geometry"/></mxCell>
        <mxCell id="c8" value="4.1 s" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="35" width="80" height="32" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;order 2&lt;br&gt;finishes&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="575" y="92" width="130" height="40" as="geometry"/></mxCell>
        <mxCell id="c10" style="sketch=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="80" as="sourcePoint"/><mxPoint x="740" y="80" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c11" value="nothing happens between events, so the clock jumps from one to the next" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="140" width="750" height="28" as="geometry"/></mxCell>
        <mxCell id="c13" value="1.5 s: order 1 finishes" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="250" height="44" as="geometry"/></mxCell>
        <mxCell id="c14" value="2.6 s: order 2 arrives" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="230" width="250" height="44" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;font style=&#x27;font-size:12px&#x27;&gt;the earliest is taken next,&lt;br&gt;so the clock jumps to 1.5 s&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1"><mxGeometry x="555" y="230" width="185" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
