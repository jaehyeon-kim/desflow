<mxfile>
  <diagram name="explain-steps" id="explain-steps">
    <mxGraphModel grid="0" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="What desflow explain does" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="720" height="30" as="geometry"/></mxCell>
        <mxCell id="s1" value="load_context&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;YAML or a builder file; nothing runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="360" height="62" as="geometry"/></mxCell>
        <mxCell id="s2" value="build_graph&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;arrivals, tasks, resources and their links&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="145" width="360" height="62" as="geometry"/></mxCell>
        <mxCell id="s3" value="rates by flow balance&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;each task's arrival rate, λ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="360" height="62" as="geometry"/></mxCell>
        <mxCell id="s4" value="which tasks the formulas cover&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;marks a task with a feature and every task after it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="335" width="360" height="62" as="geometry"/></mxCell>
        <mxCell id="s5" value="each resource: ρ, status, wait&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;Kingman or Erlang C where one applies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="360" height="62" as="geometry"/></mxCell>
        <mxCell id="s6" value="bottleneck and hints&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;units for the --target utilisation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="525" width="360" height="62" as="geometry"/></mxCell>
        <mxCell id="es1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
