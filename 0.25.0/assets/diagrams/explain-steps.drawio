        <mxCell id="v1" value="--verify: run the model&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;unpaced, no ingress or egress; one run or --replications&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="335" width="320" height="62" as="geometry"/></mxCell>
        <mxCell id="v2" value="compare&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;ρ, Lq, Wq and λ: within 10% for one run, or the 95% interval or 1%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="320" height="62" as="geometry"/></mxCell>
