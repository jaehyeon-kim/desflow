<mxfile>
  <diagram name="picker-handoff" id="crane-handoff">
    <mxGraphModel grid="0" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="One order hands over from the picker to the bench" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="750" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="picker" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="70" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="bench" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="170" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m0" value="" style="sketch=1;html=1;strokeWidth=2;endArrow=none;strokeColor=#666666;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="55" as="sourcePoint" />
            <mxPoint x="100" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" value="" style="sketch=1;html=1;strokeWidth=2;endArrow=none;strokeColor=#666666;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="125" as="sourcePoint" />
            <mxPoint x="260" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="" style="sketch=1;html=1;strokeWidth=2;endArrow=none;strokeColor=#666666;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="55" as="sourcePoint" />
            <mxPoint x="460" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="" style="sketch=1;html=1;strokeWidth=2;endArrow=none;strokeColor=#666666;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="55" as="sourcePoint" />
            <mxPoint x="750" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c3" value="picker held&lt;br&gt;&lt;font style='font-size:12px'&gt;1 s of walking, then waiting for the bench&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="waiting for the bench" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="170" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="bench held&lt;br&gt;&lt;font style='font-size:12px'&gt;4 s of packing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="170" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="queued, then picked:&lt;br&gt;picker held" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="requests the bench,&lt;br&gt;picker still held" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="190" y="240" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="at_bench:&lt;br&gt;picker released" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="390" y="240" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="finished:&lt;br&gt;bench released" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=13;align=right;" vertex="1" parent="1">
          <mxGeometry x="600" y="240" width="150" height="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>