<mxfile>
  <diagram name="container-level" id="container-level">
    <mxGraphModel grid="0" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="A DynamicContainer holds an amount up to its capacity" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="750" height="30" as="geometry"/></mxCell>
        <mxCell id="c1" value="registry&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;Shop.containers.stock.level, .current_cap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="205" y="50" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="c2" value="DynamicContainer stock" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="125" y="210" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="c3" value="current_cap: the most it holds" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="245" width="360" height="30" as="geometry"/></mxCell>
        <mxCell id="c4" value="level&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;what it holds now&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="245" y="280" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="c6" value="putters waiting&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;a restock adds 40 boxes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="c5" value="getters waiting&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;pack_order wants 1 box&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="480" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="c9" value="a live level update, clamped to&lt;br&gt;[0, current_cap], wakes both queues" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#82b366;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;align=left;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="12"/></mxGeometry></mxCell>
        <mxCell id="c8" value="put: once there&lt;br&gt;is room for it" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#d6b656;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;align=left;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.09;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="12"/></mxGeometry></mxCell>
        <mxCell id="c7" value="get: once the level&lt;br&gt;covers the amount" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;align=left;exitX=0.91;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="12"/></mxGeometry></mxCell>
        <mxCell id="c10" value="Shop.stats.containers.stock: capacity, level, getters_waiting, putters_waiting" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="580" width="750" height="30" as="geometry"/></mxCell>
