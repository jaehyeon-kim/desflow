<mxfile>
  <diagram name="ways-to-write" id="ways-to-write">
    <mxGraphModel grid="0" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Three ways to write a simulation" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="750" height="30" as="geometry"/></mxCell>
        <mxCell id="c1" value="YAML blueprint&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;a file, run by desflow run or SimulationContext.from_yaml&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="50" width="550" height="64" as="geometry"/></mxCell>
        <mxCell id="c2" value="Builder API: SimulationContext&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;add_resource, add_service, @app.task, with_stats, run()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="200" width="550" height="64" as="geometry"/></mxCell>
        <mxCell id="c3" value="Low-level API: what a script writes by hand" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=none;strokeColor=#d79b00;strokeWidth=2;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="0" y="350" width="750" height="150" as="geometry"/></mxCell>
        <mxCell id="c4" value="SimParameter&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;the parameters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="12" y="410" width="214" height="64" as="geometry"/></mxCell>
        <mxCell id="c5" value="DynamicRealtimeEnvironment&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;the registry, clock and sinks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="268" y="410" width="214" height="64" as="geometry"/></mxCell>
        <mxCell id="c6" value="SimPy processes&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;arrivals and tasks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="524" y="410" width="214" height="64" as="geometry"/></mxCell>
        <mxCell id="c7" value="makes the builder calls&lt;br&gt;a script would make" style="align=left;edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#d79b00;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="12"/></mxGeometry></mxCell>
        <mxCell id="c8" value="run() compiles the SimParameter,&lt;br&gt;builds the environment&lt;br&gt;and starts the processes" style="align=left;edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#d79b00;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="12"/></mxGeometry></mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;html=1;strokeWidth=3;endArrow=block;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
