# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# MkDocs
site/

# Local scratch (not tracked)
.ignore
.coverage

# Output written by the examples: the Parquet scripts write here unless
# PARQUET_FILESYSTEM=s3, and the backfill examples write to data/backfill.
data/
# The copied projects keep their own data folders, which their tests read
!tests/copied_projects/**/data/

# Worktrees created by Claude Code agents
.claude/worktrees/
