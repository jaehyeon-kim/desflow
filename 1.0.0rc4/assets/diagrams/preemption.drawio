        <mxCell id="x" value="express-1&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;priority 1, a new request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="0" y="100" width="170" height="70" as="geometry"/></mxCell>
