        <mxCell id="c3" value="current_cap: the most items it holds" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1"><mxGeometry x="145" y="242" width="460" height="26" as="geometry"/></mxCell>
